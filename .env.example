# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. Every value here has a working default in
# conf/config.yaml; this file only exists for secrets and host-specific paths.
# ---------------------------------------------------------------------------

# Hosted TabPFN API token. Required only when BL_PAYOUT_BACKEND=tabpfn_client.
TABPFN_TOKEN=

# Payout-model backend for the *training* services (train, scheduler). One of:
#   surrogate | tabpfn_client | tabpfn_local | catboost_fallback
# See README "Productizing TabPFN" for the trade-offs. Note that neither image
# installs the `tabpfn` extra, so `tabpfn_local` needs a rebuild to work in Docker.
BL_PAYOUT_BACKEND=catboost_fallback

# The same choice for the API, and deliberately blank. Serving reads the backend out of
# the bundle it loaded unless an operator asks for something else, which is what lets a
# rollback carry the backend its version was trained with. Fill this in only to override
# that - and note that it then applies to whatever version is serving, including one
# rolled back to. The two variables are separate for exactly that reason: the training
# default above must not silence the bundle at serve time.
BL_SERVING_PAYOUT_BACKEND=

# MLflow tracking server, for HOST commands (make train / rollback / versions). The
# compose services do not read this - they hard-set MLFLOW_TRACKING_URI=http://mlflow:5000
# to reach the mlflow container over the compose network - so this value is the one a
# host command uses to reach that same server on its published port. Leave unset to use
# the local ./mlruns file store instead.
MLFLOW_TRACKING_URI=http://localhost:5000

# Registered model and alias the serving container resolves, and the training services
# register/promote under. Interpolated into every service in docker-compose.yml, so a
# value here takes effect (set SERVING_ALIAS=challenger to canary a challenger version).
# The double underscore is the config nesting separator; defaults are in conf/config.yaml.
BL_MLFLOW__REGISTERED_MODEL=bl_brand_ranker
BL_MLFLOW__SERVING_ALIAS=champion
