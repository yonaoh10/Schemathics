# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. Every value here has a working default in
# conf/config.yaml; this file only exists for secrets and host-specific paths.
# ---------------------------------------------------------------------------

# Hosted TabPFN API token. Required only when BL_PAYOUT_BACKEND=tabpfn_client.
TABPFN_TOKEN=

# Payout-model backend. One of: tabpfn_local | tabpfn_client | surrogate | local_gbm
# See README "Productizing TabPFN" for the trade-offs.
BL_PAYOUT_BACKEND=tabpfn_local

# MLflow tracking server. Leave unset to use the local ./mlruns file store.
MLFLOW_TRACKING_URI=http://localhost:5000

# Registered model that the serving container loads at start-up.
BL_MODEL_NAME=bl_brand_ranker
BL_MODEL_ALIAS=champion
