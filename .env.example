# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. Every value here has a working default in
# conf/config.yaml; this file only exists for secrets and host-specific paths.
# ---------------------------------------------------------------------------

# Hosted TabPFN API token. Required only when BL_PAYOUT_BACKEND=tabpfn_client.
TABPFN_TOKEN=

# Payout-model backend, read by docker/docker-compose.yml. One of:
#   surrogate | tabpfn_client | tabpfn_local | catboost_fallback
# See README "Productizing TabPFN" for the trade-offs. Note that neither image
# installs the `tabpfn` extra, so `tabpfn_local` needs a rebuild to work in Docker.
BL_PAYOUT_BACKEND=catboost_fallback

# MLflow tracking server. Leave unset to use the local ./mlruns file store.
MLFLOW_TRACKING_URI=http://localhost:5000

# Registered model and alias the serving container resolves. These override
# conf/config.yaml, and the double underscore is the nesting separator.
BL_MLFLOW__REGISTERED_MODEL=bl_brand_ranker
BL_MLFLOW__SERVING_ALIAS=champion
