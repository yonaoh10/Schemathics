# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Local runtime state (all reproducible from `make` targets).
# Anchored with a leading slash: an unanchored `data/` also matches
# src/bl_ranking/data/, which is source.
/data/
/artifacts/
/mlruns/
/mlflow.db
/runs/
/loadtest/results/
*.log

# TabPFN foundation weights (44 MB), fetched on demand.
.tabpfn_models/

# Shared Prometheus counter files, one per worker per metric type. Recreated by
# scripts/serve.sh on every start.
/.metrics/

# Secrets
.env
